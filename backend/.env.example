# ============ Gemini API ============
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Proxy for Gemini API (optional — use if you get 403 PERMISSION_DENIED).
# Format: http://user:pass@host:port or http://host:port (no auth).
# Supports HTTP/HTTPS proxies. SOCKS — needs `pip install httpx[socks]`.
# Leave empty if not needed.
GEMINI_PROXY=

# ============ Google Flow (image generation) ============
# Project UUID from URL labs.google/fx/tools/flow/project/{id}
FLOW_PROJECT_ID=

# Proxy for Flow API (uploadImage + flowMedia:batchGenerateImages).
# Usually not needed. Enable only if you get 403 on Flow requests.
FLOW_PROXY=

# ============ Chrome ============
# The app will launch Chrome with this profile via start.bat.
# You log in once manually and warm up the session.
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_CDP_PORT=9224
CHROME_FLOW_PROFILE_DIR=~/.chrome-nutra-flow

# ============ Parallelism ============
FLOW_API_SEMAPHORE=5
FLOW_CHROME_COUNT=1

# ============ Web server ============
HOST=0.0.0.0
PORT=8000
STORAGE_PATH=./storage
DB_PATH=./data/nutra.db
